# Production — copy to /var/www/business-application/backend/.env on VPS
# CI/CD never overwrites this file.

PORT=5003
HOST=0.0.0.0
NODE_ENV=production

DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=business_app
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=business_management

JWT_SECRET=YOUR_LONG_RANDOM_SECRET
JWT_EXPIRE=7d
AUTH_COOKIE_NAME=bms_auth

# cPanel frontend URL (no trailing slash) — update to your real domain
CORS_ORIGIN=https://business.swiftgd.com

# Shared parent domain so login cookie works across frontend + API subdomains
COOKIE_DOMAIN=.swiftgd.com
