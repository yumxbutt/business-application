# Nginx — API reverse proxy (CWP / Ubuntu VPS)
# Example domain: baapi.swiftgd.com → proxy to Node on 127.0.0.1:5003
#
# CWP: create domain/subdomain, then use this as vhost proxy config,
# or place under nginx conf.d / sites-available and reload nginx.
# SSL: certbot --nginx -d baapi.swiftgd.com

server {
    listen 80;
    server_name baapi.swiftgd.com;

    location / {
        proxy_pass http://127.0.0.1:5003;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
